---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/kavori.css';
import '../styles/site.css';
import { site } from '../config';
const { title = site.title } = Astro.props as { title?: string };
---
<!doctype html>
<html lang="en" class="k">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#FBFBFC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101114" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Set the theme before first paint so there is no flash. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('kavori-theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          d.dataset.theme = t;
        } catch (e) { d.dataset.theme = 'light'; }
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Reveal sections as they scroll into view.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('in'));
    </script>
  </body>
</html>
