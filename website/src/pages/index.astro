---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroDemo from '../components/HeroDemo';
import JarLab from '../components/JarLab';
import Faq from '../components/Faq';
import { site } from '../config';
import { faq, compare } from '../data/content';

const uses = [
  ['c-green', 'Two WhatsApp accounts'], ['c-blue', 'Work and personal Gmail'], ['c-vermilion', 'Client dashboards'],
  ['c-violet', 'Several social accounts'], ['c-amber', 'Testing as different users'],
];
const nos = [
  ['$0 / month', 'No subscription', 'You pay once. Nothing renews.'],
  ['0 ads', 'No ads', 'None in the app or on the new-tab page.'],
  ['0 trackers', 'No data collection', 'No analytics or telemetry. Logins and history stay on your computer.'],
  ['$0 upgrades', 'Free updates', 'Every future version is included.'],
];
const secs = [
  ['box', 'Separate sessions', 'A group’s cookies, storage and cache sit in their own partition. Other groups can’t read them.'],
  ['shield', 'Sandboxed pages', 'Web pages run in sandboxed processes and can’t reach the app’s own code.'],
  ['lock', 'Permissions per group', 'If you allow the camera for a site in one group, the other groups still ask.'],
  ['eyeoff', 'No telemetry', 'Kavori doesn’t send analytics or browsing data anywhere, and there’s no account to create.'],
];
---
<Base>
  <Nav />

  <main id="top">
    <!-- Hero -->
    <section class="hero">
      <div class="wrap">
        <div class="pillrow rise"><span class="pill"><span class="dot"></span>Pay once. No subscription, no ads, no tracking.</span></div>
        <h1 class="rise d1">Log in to the same site <em>as many times</em> as you like.</h1>
        <p class="lede rise d2">Kavori keeps each login in its own container, so a second WhatsApp or Gmail account doesn’t sign out the first. Works on Mac, Windows and Linux.</p>
        <div class="cta-row rise d3">
          <a class="btn btn-primary" href="#pricing">Buy Kavori, {site.price}<Icon name="arrow" class="ic arrow" /></a>
          <a class="btn btn-secondary" href="#why">How it works</a>
        </div>
        <div class="plat rise d4"><span>Mac</span><span>Windows</span><span>Linux</span><span>Free updates</span></div>
        <div class="rise d5"><HeroDemo client:load /></div>
        <div class="uses" aria-label="Things people use Kavori for">
          {uses.map(([c, t], i) => <span class={`use ${c}`} data-reveal style={`--i:${i}`}><i></i>{t}</span>)}
        </div>
      </div>
    </section>

    <!-- Why -->
    <section class="sec why" id="why">
      <div class="wrap why-grid">
        <div data-reveal>
          <p class="eyebrow">How it works</p>
          <h2 class="h2">A normal browser keeps one set of cookies per site.</h2>
          <p class="lede">That’s why logging in to a second account signs you out of the first. Browser profiles get around it, but each profile is its own window with its own settings. In Kavori every group has separate cookies, storage and cache, and they all live in one window.</p>
          <div class="points">
            <div class="point"><span class="num">1</span><div><b>Make a group for each account</b><span>Give it a name and a color, open a site in it and log in.</span></div></div>
            <div class="point"><span class="num">2</span><div><b>Groups can’t see each other</b><span>Cookies, storage and cache are separate, so a site in one group can’t tell the others exist.</span></div></div>
            <div class="point"><span class="num">3</span><div><b>Switch from the sidebar</b><span>Or press ⌘K and type the group’s name.</span></div></div>
          </div>
        </div>
        <div data-reveal style="--i:2"><JarLab client:visible /></div>
      </div>
    </section>

    <!-- Features -->
    <section class="sec" id="features">
      <div class="wrap">
        <div class="sec-head center" data-reveal>
          <p class="eyebrow">Features</p>
          <h2 class="h2">What you get</h2>
        </div>
        <div class="bento">
          <div class="f w3" data-reveal>
            <div class="f-vis"><span class="tile mini-tile c-vermilion">S</span><span class="tile mini-tile c-blue">P</span><span class="tile mini-tile c-green">A</span></div>
            <h3>Containers</h3>
            <p>Every group has its own cookies, storage and cache. The same site can be open in three groups, logged in as three different people.</p>
          </div>
          <div class="f w3" data-reveal style="--i:1">
            <div class="f-vis"><span class="sw"></span><span style="color:var(--text-3);font-size:14px">Wipe on quit</span></div>
            <h3>Temporary groups</h3>
            <p>Mark a group temporary and everything in it is deleted when you quit. Handy for logging in somewhere once.</p>
          </div>
          <div class="f" data-reveal>
            <div class="f-vis"><div class="row-kbd"><span class="kbds"><span class="kbd press">⌘</span><span class="kbd press">K</span></span><Icon name="search" class="ic" /></div></div>
            <h3>⌘K</h3>
            <p>Jump to a group, an open tab or a command by typing.</p>
          </div>
          <div class="f" data-reveal style="--i:1">
            <div class="f-vis"><span class="tile c-blue">P</span><span class="badge" style="margin-left:-22px;margin-top:-30px">12</span></div>
            <h3>Unread counts</h3>
            <p>Each group shows its unread count, and the Dock icon shows the total. This works for sites that put the count in the page title.</p>
          </div>
          <div class="f" data-reveal style="--i:2">
            <div class="f-vis"><span class="f-ic"><Icon name="cookie" class="ic ic-lg" /></span></div>
            <h3>Cookie settings per group</h3>
            <p>Turn third-party cookie blocking on or off for each group.</p>
          </div>
          <div class="f w4" data-reveal>
            <div class="f-vis"><div class="themes"><span class="th"><i class="a" style="background:#EDEEF1"></i><i class="b" style="background:#fff"></i></span><span class="th"><i class="a" style="background:#141518"></i><i class="b" style="background:#1B1D21"></i></span></div></div>
            <h3>Light and dark</h3>
            <p>Follows your system, or pick one yourself. Animations tone down if your OS is set to reduce motion.</p>
          </div>
          <div class="f" data-reveal style="--i:1">
            <div class="f-vis"><div class="plats"><span>macOS</span><span>Windows</span><span>Linux</span></div></div>
            <h3>Mac, Windows, Linux</h3>
            <p>One license covers all three.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section class="sec why" id="pricing">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <p class="eyebrow">Pricing</p>
          <h2 class="h2">Pay once and it’s yours.</h2>
          <p class="lede">No subscription, no ads, no tracking. Future updates are free.</p>
        </div>
        <div class="price-wrap">
          <div class="nos">
            {nos.map(([b, t, d], i) => <div class="no" data-reveal style={`--i:${i}`}><b>{b}</b><span>{t}</span><p>{d}</p></div>)}
          </div>
          <div class="buy" data-reveal style="--i:2">
            <span class="lbl">Kavori, all platforms</span>
            <div class="amt">{site.price}<small>one-time</small></div>
            <ul>
              {['Mac, Windows and Linux', 'Unlimited groups and tabs', 'Free updates for every future version', 'Security fixes included'].map((t) => <li><Icon name="check" />{t}</li>)}
            </ul>
            <a class="btn" href={site.buyUrl}>Buy Kavori<Icon name="arrow" class="ic arrow" /></a>
            <p class="fine">{site.refundDays}-day refund. <a href="/refunds">Details</a><br />By buying you agree to the <a href="/terms">Terms</a> and <a href="/license">License</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Security -->
    <section class="sec" id="security">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <p class="eyebrow">Security</p>
          <h2 class="h2">How the separation works</h2>
          <p class="lede">Each group runs in its own Chromium session. In practice that means this:</p>
        </div>
        <div class="sec-grid">
          {secs.map(([i, t, d], n) => <div class="s" data-reveal style={`--i:${n}`}><span class="f-ic"><Icon name={i} class="ic ic-lg" /></span><h3>{t}</h3><p>{d}</p></div>)}
        </div>
        <div class="promise" data-reveal>
          <Icon name="refresh" />
          <p>Kavori is built on Chromium. When Chromium gets a security fix, we release an update. It’s included in the price.</p>
        </div>
      </div>
    </section>

    <!-- Compare -->
    <section class="sec why" id="compare">
      <div class="wrap">
        <div class="sec-head center" data-reveal>
          <p class="eyebrow">Compare</p>
          <h2 class="h2">How Kavori compares</h2>
          <p class="lede">Ferdium and Firefox Containers are free, and either may be all you need. Here’s where they differ.</p>
        </div>
        <div class="cmp-box" data-reveal>
          <table class="cmp">
            <thead>
              <tr><th></th>{compare.columns.map((c) => <th class={c.us ? 'us' : ''}>{c.name}<small>{c.sub}</small></th>)}</tr>
            </thead>
            <tbody>
              {compare.rows.map(([label, cells]) => (
                <tr><th>{label}</th>{cells.map((c, i) => <td class={i === 0 ? 'us' : ''}>{c.t}{c.win && <> <span class="tag win">{c.win}</span></>}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="cmp-note">Compared in {site.comparedOn}. Prices and features change, so check each site.</p>
        <div class="choose">
          <div class="ch" data-reveal><span class="tag">Ferdium</span><b>Pick Ferdium if free and open source matter most.</b><p>It costs nothing and the code is public. Updates and security depend on its community.</p></div>
          <div class="ch" data-reveal style="--i:1"><span class="tag">Firefox Containers</span><b>Pick Containers if you already use Firefox.</b><p>It’s free, and enough if you only need separate cookies. History and extensions are shared between containers.</p></div>
          <div class="ch" data-reveal style="--i:2"><span class="tag win">Kavori</span><b>Pick Kavori if you’d rather pay once.</b><p>You get updates for good, and a maintainer who handles security fixes.</p></div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="sec" id="faq">
      <div class="wrap">
        <div class="sec-head center" data-reveal><h2 class="h2">Questions</h2></div>
        <div data-reveal><Faq items={faq} client:visible /></div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="final" id="buy">
      <div class="wrap" data-reveal>
        <h2>Kavori is {site.price}, once.</h2>
        <p class="lede">Mac, Windows and Linux. Every future update is included.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={site.buyUrl}>Buy Kavori, {site.price}<Icon name="arrow" class="ic arrow" /></a>
          <a class="btn btn-secondary" href="#why">How it works</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
